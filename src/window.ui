                                    <property name="visible">True</property>
                                    <property name="focusable">False</property>
                                    <property name="label" translatable="yes">Warning: If you can't find the folder you are wishing to install fonts to, it might be because this application doesn't have access to it, to correct this, install Flatseal and give this application access to the folder.</property>
